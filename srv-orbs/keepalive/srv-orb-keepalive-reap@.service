[Unit]
Description=Stop %i orbs that Amp paused more than SRV_ORB_KEEPALIVE_HOURS ago
After=network-online.target

[Service]
Type=oneshot
User=srv-orbs
Group=srv-orbs
StateDirectory=srv-orbs
StateDirectoryMode=0700
Environment=HOME=/var/lib/srv-orbs
EnvironmentFile=/etc/%i.env
ExecStart=/usr/local/bin/srv-orb-keepalive reap
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
