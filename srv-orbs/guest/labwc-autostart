# /etc/xdg/labwc/autostart: runs inside Amp's orb Desktop session.
# - at-spi-bus-launcher starts with the accessibility bus disabled and, since
#   at-spi2-core 2.62, never reads a default; enable it so toolkits register.
# - Amp starts Desktop apps as transient systemd units without the session's
#   D-Bus address, so they cannot ask for the accessibility bus. Link its socket
#   to a fixed path, $XDG_RUNTIME_DIR/at-spi-bus, which the unit drop-in
#   run-.service.d/amp-desktop-accessibility.conf hands them as AT_SPI_BUS_ADDRESS.
# - Xwayland clients find the bus through the AT_SPI_BUS root-window property,
#   which the launcher sets only when X is up as it starts, so publish it once
#   Xwayland answers (xsettingsd keeps it running for the whole session).
# - Open normal app windows maximized, so agent-desktop knows where they are and
#   can show its cursor (see /usr/local/lib/srv/amp-desktop-maximize).
/usr/local/lib/srv/amp-desktop-maximize >/dev/null 2>&1
# - Amp's Desktop stream encodes only on screen damage, so a viewer that
#   reconnects to a static screen (after the stream restarted) gets no first
#   frame. A transparent 1x1 overlay surface is recommitted 1, 3 and 6 seconds
#   after each viewer connects (see /usr/local/lib/srv/amp-desktop-repaint).
/usr/local/lib/srv/amp-desktop-repaint >/dev/null 2>&1 &
repaint=$!
(
	tail -n 0 -F "$HOME/.cache/amp/desktop/waymote.log" 2>/dev/null | while IFS= read -r line; do
		case $line in
		*"video client "*" connected"*)
			(for delay in 1 2 3; do sleep "$delay"; kill -USR1 "$repaint" 2>/dev/null; done) & ;;
		esac
	done
) >/dev/null 2>&1 &
(
	enabled=
	for _ in $(seq 50); do
		busctl --user set-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled b true
		enabled="$(busctl --user get-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled)"
		[ "$enabled" = 'b true' ] && break
		sleep 0.2
	done
	address="$(busctl --user call org.a11y.Bus /org/a11y/bus org.a11y.Bus GetAddress | sed -n 's/^s "\(.*\)"$/\1/p')"
	socket="${address#unix:path=}"
	socket="${socket%%,*}"
	[ -S "$socket" ] && ln -sfn "$socket" "$XDG_RUNTIME_DIR/at-spi-bus"
	for _ in $(seq 100); do
		xprop -root -len 0 >/dev/null 2>&1 && break
		sleep 0.1
	done
	[ -n "$address" ] && xprop -root -f AT_SPI_BUS 8s -set AT_SPI_BUS "$address"
) >/dev/null 2>&1 &
