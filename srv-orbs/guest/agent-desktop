#!/usr/bin/env bash
# /usr/local/bin/agent-desktop: runs the real CLI (/opt/agent-desktop) inside
# Amp's orb Desktop session from any shell, with the agent's cursor shown.
#
# Amp's agent shell is not part of that session. Amp records its display and
# runtime directory in ~/.cache/amp/desktop/environment but not the session's
# D-Bus address, which agent-desktop needs to reach the AT-SPI accessibility
# bus; that address is read from the session's compositor (labwc). A shell that
# already has WAYLAND_DISPLAY or DISPLAY (for example a terminal opened on the
# Desktop) is left as it is.
#
# agent-desktop draws its cursor overlay (glide, click ripple, action label) only
# inside an agent-desktop session. Unless the caller picked one
# (AGENT_DESKTOP_SESSION or --session), every command runs in one session per
# Desktop run, started with --cursor, so the person watching the Desktop tab
# sees where the agent acts. A Desktop restart (new labwc) ends the old session
# and starts a new one.
set -euo pipefail

real=/opt/agent-desktop/agent-desktop
env_file="${HOME:-/home/user}/.cache/amp/desktop/environment"

desktop_pid=
if [[ -z ${WAYLAND_DISPLAY:-}${DISPLAY:-} && -r $env_file ]]; then
	# shellcheck source=/dev/null
	. "$env_file"
	desktop_pid="$(pgrep -u "$(id -u)" -x labwc | head -n1 || true)"
	if [[ -n $desktop_pid ]]; then
		bus="$(tr '\0' '\n' <"/proc/$desktop_pid/environ" 2>/dev/null | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n1)"
		[[ -n $bus ]] && export DBUS_SESSION_BUS_ADDRESS="$bus"
	else
		echo "agent-desktop: the orb Desktop is not running; open the Desktop tab in the thread (or run: sudo systemctl start amp-desktop)" >&2
	fi
fi

explicit_session=false
for arg in "$@"; do
	[[ $arg == --session || $arg == --session=* ]] && explicit_session=true
done

if [[ -n $desktop_pid && -z ${AGENT_DESKTOP_SESSION:-} && $explicit_session == false ]]; then
	state="${XDG_RUNTIME_DIR:?}/agent-desktop-cursor-session"
	exec 9>>"$state.lock"
	flock 9
	owner= session=
	[[ -s $state ]] && read -r owner session <"$state"
	if [[ ${owner:-} != "$desktop_pid" || -z ${session:-} ]]; then
		# 9>&-: the overlay helper outlives this call and must not hold the lock.
		[[ -n ${session:-} ]] && "$real" --session "$session" session end >/dev/null 2>&1 9>&- || true
		session="$("$real" session start --cursor --name amp-desktop 9>&- | jq -r '.data.activation.value // empty')"
		[[ -n $session ]] && printf '%s %s\n' "$desktop_pid" "$session" >"$state"
	fi
	exec 9>&-
	[[ -n ${session:-} ]] && export AGENT_DESKTOP_SESSION="$session"
fi

exec "$real" "$@"
