# Template for /etc/amp-orb-tailscale.env in the amp-orb image. build-image.sh
# renders the @…@ placeholders from site.env (AMP_WORKSPACE_ID, ORB_TAILSCALE_*).
# Tailscale trust credential (OIDC, issuer https://ampcode.com/api/workload-identity,
# subject workspace:@AMP_WORKSPACE_ID@). These are identifiers, not secrets.
TAILSCALE_CLIENT_ID=@ORB_TAILSCALE_CLIENT_ID@
TAILSCALE_AUDIENCE=@ORB_TAILSCALE_AUDIENCE@
TAILSCALE_TAGS=@ORB_TAILSCALE_TAGS@
