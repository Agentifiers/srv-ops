# Template for /etc/srv-orbs-mobile.env (root:root 0600). `../install.sh`
# renders the @…@ placeholders from site.env and keeps the
# AMP_ORB_PROVIDER_TOKEN line of an existing file. Add the token of the mobile
# provider from Amp workspace Settings -> Orbs privately; never commit it.
# AMP_ORB_PROVIDER_TOKEN=...
SRV_ORB_ENDPOINT=@SRV_HOST@
SRV_ORB_STATE_DIR=/var/lib/srv-orbs/dispatch-mobile
SRV_ORB_IMAGE=@MOBILE_ORB_IMAGE@
ORB_IMAGE=@MOBILE_ORB_IMAGE@
SRV_ORB_CPUS=@MOBILE_ORB_CPUS@
SRV_ORB_RAM=@MOBILE_ORB_RAM@
SRV_ORB_DISK=@MOBILE_ORB_DISK@
