def status():
    try:
        st = broker("GET", "/v1/status")
    except BrokerError as e:
        fail(str(e))
    print(json.dumps(st, indent=2))
    host_app, runner_app, stamp = runner_bundles()
    print(f"runner build {stamp}: {bundle_info(runner_app)['CFBundleIdentifier']}, {bundle_info(host_app)['CFBundleIdentifier']}")
    return 0


def main():
    name = os.path.basename(sys.argv[0])
    args = sys.argv[1:]
    if name == "xcrun":
        return xcrun(args)
    if name == "xcodebuild":
        return xcodebuild(args)
    if name == "DevToolsSecurity":
        # The macOS debugger-access setting agent-device checks before starting a device runner;
        # here the broker's host runs the runner, so there is nothing to gate.
        print("Developer mode is currently enabled.")
        return 0
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = args[0], args[1:]
    if cmd == "xcrun":
        return xcrun(rest)
    if cmd == "xcodebuild":
        return xcodebuild(rest)
    if cmd == "usbmuxd":
        path = take_opt(rest, "--socket") or "/run/usbmuxd"
        asyncio.run(usbmuxd_main(path))
        return 0
    if cmd == "install-runner":
        force = bool(take_opt(rest, "--force", flag=True))
        try:
            acquire_lease()
            host_app, runner_app, stamp = runner_bundles()
            ids = ensure_runner_installed(host_app, runner_app, stamp, force=force)
        except BrokerError as e:
            fail(str(e))
        print(f"runner {stamp} installed: {', '.join(ids)}")
        return 0
    if cmd == "release":
        try:
            broker("DELETE", "/v1/lease")
        except BrokerError as e:
            fail(str(e))
        return 0
    if cmd == "status":
        return status()
    fail(f"agent-device-ios: unknown command {cmd} (see --help)")


if __name__ == "__main__":
    sys.exit(main() or 0)
