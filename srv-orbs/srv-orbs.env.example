# Template for /etc/srv-orbs.env (root:root 0600). `install.sh` renders the
# @…@ placeholders from site.env and keeps the AMP_ORB_PROVIDER_TOKEN line of an
# existing file. Add the provider token from Amp workspace Settings -> Orbs
# privately; never commit it.
# AMP_ORB_PROVIDER_TOKEN=...
SRV_ORB_ENDPOINT=@SRV_HOST@
SRV_ORB_STATE_DIR=/var/lib/srv-orbs/dispatch
SRV_ORB_IMAGE=@ORB_IMAGE@
ORB_IMAGE=@ORB_IMAGE@
SRV_ORB_CPUS=@ORB_CPUS@
SRV_ORB_RAM=@ORB_RAM@
SRV_ORB_DISK=@ORB_DISK@
