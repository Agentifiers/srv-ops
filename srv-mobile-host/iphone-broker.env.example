# /etc/srv-mobile/iphone-broker.env (root 0644; no secrets). install.sh renders it from
# this template, filling the placeholders from the repo's site.env; edit the installed file afterwards.
# Lists are comma or space separated. Empty lists grant nothing.

# The phone's UDID. Empty: the broker uses the one iPhone pmd3-tunneld (or usbmuxd) sees and
# refuses to start when there is none or more than one. Set it to pin a phone.
IPHONE_UDID=
# The host's tailnet address (required): the API listens there only.
BROKER_BIND=@SITE_HOST_TAILNET_IP@
BROKER_PORT=@IPHONE_BROKER_PORT@
# TCP forwards (device ports, live view) are opened on BROKER_BIND in this range.
FORWARD_PORTS=@IPHONE_BROKER_FORWARD_PORTS@
# Callers: nodes with one of these tags (orbs), untagged devices of these logins
# (admins: force-release, live view without the lease, any app), and, for tests,
# these node names (e.g. mobile-test VMs: TEST_NODES=mt-phonebroker-1,mt-phonebroker-2).
ALLOW_TAGS=@ORB_TAILSCALE_TAGS@
ADMIN_LOGINS=@SITE_ADMIN_LOGINS@
TEST_NODES=
# Lease auto-release after this many seconds without a call.
IDLE_TIMEOUT=@IPHONE_LEASE_IDLE_SECONDS@
# /v1/sign and /v1/apps/install accept only explicit bundle ids under these prefixes
# (include the trailing dot, e.g. com.example.).
BUNDLE_PREFIXES=@APPLE_BUNDLE_PREFIX@
# Besides broker-installed apps, non-admins may launch/terminate only these.
LAUNCH_ALLOW=com.apple.Preferences,com.apple.mobilesafari
TUNNELD=127.0.0.1:49151

# "lat,lon" near the phone's real location, e.g. 37.3349,-122.0090. A simulated location
# also moves the phone's time zone; ending a simulation (clear or lease release) first
# simulates this spot for 20 s so the clock comes back immediately. Empty: plain clear.
HOME_LOCATION=@IPHONE_HOME_LOCATION@
