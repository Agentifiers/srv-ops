From dbbcc946108f49077cffe1ae82b0f866420b1c05 Mon Sep 17 00:00:00 2001
From: Ben Kraus <406385+benkraus@users.noreply.github.com>
Date: Tue, 27 Oct 2026 09:53:34 -0700
Subject: [PATCH] Keep an empty /etc/machine-id in project templates

The template sanitizer deleted /etc/machine-id. systemd treats a missing
machine-id as first boot, so every clone ran the preset policy and enabled
systemd-networkd-wait-online, which stalled boot for up to two minutes and
failed the first orb bootstrap. Write back an empty, root-owned 0444 file:
clones still get a fresh transient ID on each boot, without first-boot
semantics.
---
 internal/provision/template_sanitize.go | 64 ++++++++++++++++++++++++-
 internal/provision/template_test.go     | 25 +++++++---
 2 files changed, 82 insertions(+), 7 deletions(-)

diff --git a/internal/provision/template_sanitize.go b/internal/provision/template_sanitize.go
index 76ee6cd..9c26e8b 100644
--- a/internal/provision/template_sanitize.go
+++ b/internal/provision/template_sanitize.go
@@ -5,7 +5,9 @@ import (
 	"context"
 	"errors"
 	"fmt"
+	"os"
 	"os/exec"
+	"regexp"
 	"strconv"
 	"strings"
 )
@@ -28,7 +30,10 @@ func (d *templateDisk) command(operation, path string) (string, error) {
 	if strings.ContainsAny(path, "\x00\r\n\"\\") {
 		return "", errors.New("unsupported escape or control character in cleanup path")
 	}
-	command := operation + " \"" + path + "\""
+	return d.run(operation + " \"" + path + "\"")
+}
+
+func (d *templateDisk) run(command string) (string, error) {
 	cmd := exec.CommandContext(d.ctx, "debugfs", "-w", "-R", command, d.path)
 	var stderr bytes.Buffer
 	cmd.Stderr = &stderr
@@ -140,6 +145,60 @@ func (d *templateDisk) clean(path string) error {
 	return nil
 }
 
+var emptyMachineIDStat = regexp.MustCompile(`(?s)Type: regular\s+Mode:\s+0444\b.*User:\s+0\s+Group:\s+0\b.*Size: 0\n`)
+
+// resetMachineID leaves /etc/machine-id as an empty, root-owned, read-only file.
+// A missing machine-id makes systemd treat the clone's boot as its first boot:
+// it applies the preset policy, which enables units such as
+// systemd-networkd-wait-online that stall boot past the orb bootstrap deadline.
+// An empty file still gets a fresh transient ID on every boot, so clones never
+// share the source's identity.
+func (d *templateDisk) resetMachineID() error {
+	entries, err := d.list("/")
+	if err != nil {
+		return err
+	}
+	hasEtc := false
+	for _, entry := range entries {
+		if entry.name == "etc" {
+			if entry.mode&0170000 != 0040000 {
+				return errors.New("unsafe non-directory /etc in template")
+			}
+			hasEtc = true
+		}
+	}
+	if !hasEtc {
+		return nil
+	}
+	empty, err := os.CreateTemp("", "srv-empty-machine-id-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(empty.Name())
+	if err := empty.Close(); err != nil {
+		return err
+	}
+	if strings.ContainsAny(empty.Name(), "\x00\r\n\"\\ ") {
+		return errors.New("unsupported temporary file path for debugfs")
+	}
+	if _, err := d.run("write " + empty.Name() + " \"/etc/machine-id\""); err != nil {
+		return err
+	}
+	for _, field := range []string{"uid 0", "gid 0", "mode 0100444"} {
+		if _, err := d.run("set_inode_field \"/etc/machine-id\" " + field); err != nil {
+			return err
+		}
+	}
+	out, err := d.command("stat", "/etc/machine-id")
+	if err != nil {
+		return err
+	}
+	if !emptyMachineIDStat.MatchString(out) {
+		return fmt.Errorf("machine-id reset verification failed: %s", out)
+	}
+	return nil
+}
+
 func sanitizeTemplateDisk(ctx context.Context, path string) error {
 	if err := runRootFSCheckContext(ctx, path, "check template filesystem before cleanup"); err != nil {
 		return err
@@ -160,5 +219,8 @@ func sanitizeTemplateDisk(ctx context.Context, path string) error {
 			}
 		}
 	}
+	if err := d.resetMachineID(); err != nil {
+		return err
+	}
 	return runRootFSCheckContext(ctx, path, "check template filesystem after cleanup")
 }
diff --git a/internal/provision/template_test.go b/internal/provision/template_test.go
index 058f7c3..3e27146 100644
--- a/internal/provision/template_test.go
+++ b/internal/provision/template_test.go
@@ -70,9 +70,9 @@ func TestProjectTemplateLifecycleAndIdentityCleanup(t *testing.T) {
 	p := &Provisioner{cfg: cfg, store: st, log: slog.New(slog.NewTextHandler(io.Discard, nil))}
 	inst := provisionTestInstance(cfg, "source", model.StateStopped, time.Now())
 	actor := model.Actor{UserLogin: inst.CreatedByUser}
-	removed := []string{"etc/machine-id", "var/lib/dbus/machine-id", "var/lib/tailscale/tailscaled.state", "var/lib/tailscale/ssh/ssh_host_ed25519_key", "var/lib/tailscale/My Notes Grüße", "var/lib/srv/bootstrap.done", "var/lib/systemd/random-seed", "root/.config/amp/secrets.json", "root/.local/share/amp/session.json", "home/user/.local/share/amp/device-id.json", "home/user/.local/share/amp/secrets.json"}
+	removed := []string{"var/lib/dbus/machine-id", "var/lib/tailscale/tailscaled.state", "var/lib/tailscale/ssh/ssh_host_ed25519_key", "var/lib/tailscale/My Notes Grüße", "var/lib/srv/bootstrap.done", "var/lib/systemd/random-seed", "root/.config/amp/secrets.json", "root/.local/share/amp/session.json", "home/user/.local/share/amp/device-id.json", "home/user/.local/share/amp/secrets.json"}
 	kept := []string{"home/user/.amp/bin/amp", "root/.amp/bin/amp", "home/user/.config/amp/settings.json", "home/user/.config/amp/skills/custom/SKILL.md", "home/user/.local/share/amp/prepared-state", "home/user/My Notes Grüße", "home/user/project/.agents/setup", "home/user/project/code.go", "etc/hostname"}
-	files := map[string]string{}
+	files := map[string]string{"etc/machine-id": "payload-etc/machine-id"}
 	for _, path := range append(removed, kept...) {
 		files[path] = "payload-" + path
 	}
@@ -99,6 +99,7 @@ func TestProjectTemplateLifecycleAndIdentityCleanup(t *testing.T) {
 			t.Errorf("identity retained at %s: %s", path, out)
 		}
 	}
+	assertEmptyMachineID(t, disk)
 	for _, path := range kept {
 		out, err := exec.Command("debugfs", "-R", "cat \"/"+path+"\"", disk).Output()
 		if err != nil || string(out) != files[path] {
@@ -272,10 +273,7 @@ func TestCreateUsesOwnerTemplateWithFreshInstanceIdentity(t *testing.T) {
 			if err != nil || string(out) != "prepared" {
 				t.Fatalf("prepared project missing: %q %v", out, err)
 			}
-			out, _ = exec.Command("debugfs", "-R", "stat /etc/machine-id", dest).CombinedOutput()
-			if !strings.Contains(string(out), "File not found") {
-				t.Fatal("old machine identity cloned")
-			}
+			assertEmptyMachineID(t, dest)
 			return stop
 		}
 		return nil
@@ -338,3 +336,18 @@ func TestTemplateCancellationCleansStaging(t *testing.T) {
 		t.Fatalf("cancelled snapshot retained staging/publication: %v %v", entries, err)
 	}
 }
+
+// assertEmptyMachineID checks that a template-derived disk has an empty,
+// root-owned, read-only /etc/machine-id: no cloned identity, and no systemd
+// first-boot preset run (which a missing file triggers) on the clone.
+func assertEmptyMachineID(t *testing.T, disk string) {
+	t.Helper()
+	out, err := exec.Command("debugfs", "-R", "cat /etc/machine-id", disk).Output()
+	if err != nil || len(out) != 0 {
+		t.Fatalf("machine-id not empty: %q %v", out, err)
+	}
+	stat, _ := exec.Command("debugfs", "-R", "stat /etc/machine-id", disk).CombinedOutput()
+	if !emptyMachineIDStat.Match(stat) {
+		t.Fatalf("machine-id not an empty root-owned 0444 file: %s", stat)
+	}
+}
