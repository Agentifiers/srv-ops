# Site configuration for this repo. Copy to `site.env` (gitignored) and fill in.
# Build scripts and installers source it through common/site-env.sh; values
# already set in the environment win. Anything left empty that a script needs
# makes it stop with a message naming the variable. Defaults shown are what
# the scripts assume when you leave a line out.

# --- Tailnet ------------------------------------------------------------------
# Tailnet name as used by the Tailscale API (srv's TS_TAILNET), e.g. example.github.
SITE_TAILNET=
# MagicDNS suffix, e.g. example-tailnet.ts.net.
SITE_TAILNET_DNS=
# Tailscale logins (comma separated) that administer srv and the iPhone broker.
SITE_ADMIN_LOGINS=
# Tags. srv mints keys with SITE_TAG_GHA for CI/hand-made VMs; orbs join with
# ORB_TAILSCALE_TAGS themselves; SITE_TAG_SRV is srv's own control-plane tag.
SITE_TAG_SRV=tag:srv
SITE_TAG_GHA=tag:gha
ORB_TAILSCALE_TAGS=tag:amp-orb

# --- Host ---------------------------------------------------------------------
# Tailscale IPv4 and MagicDNS short name of the srv host. GARM, bazel-remote
# and iphone-broker bind to the IP; orb and CI images point at it.
SITE_HOST_TAILNET_IP=
SITE_HOST_TS_NAME=
# SSH destination of srv's control plane (its tsnet hostname, SRV_HOSTNAME).
SRV_HOST=srv
# Checkout of upstream srv (https://github.com/HeavyHorst/srv).
SRV_SRC_DIR=/opt/src/srv
# srv paths and network (must match /etc/srv/srv.env).
SRV_DATA_DIR=/var/lib/srv
SRV_IMAGES_DIR=/var/lib/srv/images
SRV_JAILER_BASE_DIR=/srv/jail
SRV_VM_NETWORK_CIDR=172.28.0.0/16
SRV_AMP_CONNECT_GATEWAY_PORT=3128

# --- Orbs (srv-orbs/) -----------------------------------------------------------
# Amp workspace UUID (AMP_WORKSPACE_ID inside an orb) and the Tailscale OIDC
# trust credential that trusts it (srv-orbs/README.md). Identifiers, not secrets.
AMP_WORKSPACE_ID=
ORB_TAILSCALE_CLIENT_ID=
ORB_TAILSCALE_AUDIENCE=
# srv image names and the per-orb shape of each Amp provider.
ORB_IMAGE=amp-orb
ORB_CPUS=4
ORB_RAM=8G
ORB_DISK=20G
MOBILE_ORB_IMAGE=amp-orb-mobile
MOBILE_TEST_IMAGE=mobile-test
MOBILE_ORB_CPUS=8
MOBILE_ORB_RAM=16G
MOBILE_ORB_DISK=80G
MOBILE_IMAGE_SIZE=60G
# Amp pauses idle orbs after a few minutes, and srv's dispatcher stops the VM on
# pause. Both providers instead keep a paused orb running this many hours
# (0 = stop on every pause); see srv-orbs/README.md "Keep-alive".
ORB_KEEPALIVE_HOURS=24
# Where large downloads (Xcode .xip, Android SDK, …) are cached on the host.
MOBILE_CACHE_DIR=/var/cache/srv-mobile

# --- Mobile: shared iPhone (srv-mobile-host/) -----------------------------------
IPHONE_BROKER_PORT=8787
# Ports for leaseholder TCP forwards (first-last).
IPHONE_BROKER_FORWARD_PORTS=8790-8799
# The broker signs development builds only for bundle ids with this prefix
# (include the trailing dot), e.g. com.example.
APPLE_BUNDLE_PREFIX=
# Restored after location simulation ("lat,lon"); empty = just clear.
IPHONE_HOME_LOCATION=
# Lease auto-release after this many idle seconds.
IPHONE_LEASE_IDLE_SECONDS=600

# --- CI (srv-gha/) ----------------------------------------------------------------
GHA_RUNNER_IMAGE=gha-runner
# Exact Node versions baked into the runner's tool cache for actions/setup-node
# (comma separated, e.g. the .node-version of your repos); empty = none.
GHA_NODE_VERSIONS=
GARM_API_PORT=9997
# Public webhook port served through Tailscale Funnel (443, 8443 or 10000).
GARM_WEBHOOK_FUNNEL_PORT=8443
BAZEL_REMOTE_GRPC_PORT=9092
BAZEL_REMOTE_HTTP_PORT=9093
BAZEL_REMOTE_MAX_SIZE_GIB=500
BAZEL_REMOTE_DIR=/var/lib/bazel-remote
